{
	"name": "pi-deepseek-vision",
	"version": "0.2.0",
	"description": "Vision preprocessing for DeepSeek models in Pi",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
